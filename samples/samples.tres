[gd_resource type="Resource" script_class="SampleLibrary" load_steps=21 format=3]

[ext_resource type="Script" path="res://shared/sample_library.gd" id="1_library"]
[ext_resource type="Script" path="res://shared/sample_info.gd" id="2_info"]

[sub_resource type="Resource" id="Sample_passthrough"]
script = ExtResource("2_info")
title = "パススルー"
description = "Alpha environment blendでMRを開始し、blend modeを切り替えて違いを見る。"
scene = "res://samples/passthrough/sample.tscn"
devices = 15
notes = ""

[sub_resource type="Resource" id="Sample_hand_tracking"]
script = ExtResource("2_info")
title = "Hand Tracking"
description = "XRHandTrackerの26関節を表示し、光学式とコントローラー由来を見分ける。"
scene = "res://samples/hand_tracking/sample.tscn"
devices = 15
notes = "Hand Trackingの有効化が必要"

[sub_resource type="Resource" id="Sample_controller_models"]
script = ExtResource("2_info")
title = "コントローラーモデル"
description = "runtimeが提供するコントローラーの3Dモデルを表示し、非対応時は球へ落とす。"
scene = "res://samples/controller_models/sample.tscn"
devices = 15
notes = "core / Metaの2経路"

[sub_resource type="Resource" id="Sample_session_lifecycle"]
script = ExtResource("2_info")
title = "セッションの扱い"
description = "リフレッシュレートの選択、フォーカス喪失と復帰、recenterの受け取り方。"
scene = "res://samples/session_lifecycle/sample.tscn"
devices = 15
notes = ""

[sub_resource type="Resource" id="Sample_poke_button"]
script = ExtResource("2_info")
title = "押せるボタン"
description = "指先やコントローラーでボタンを押し込む。押し込み量から見た目と判定を作る。"
scene = "res://samples/poke_button/sample.tscn"
devices = 15
notes = "指で押すにはHand Tracking"

[sub_resource type="Resource" id="Sample_ray_pointer"]
script = ExtResource("2_info")
title = "遠隔ポインタ"
description = "レイで離れた対象を選ぶ。手を近づけるとレイを引っ込めて近接に切り替える。"
scene = "res://samples/ray_pointer/sample.tscn"
devices = 15
notes = ""

[sub_resource type="Resource" id="Sample_grab_object"]
script = ExtResource("2_info")
title = "掴んで動かす"
description = "pinchまたはgripで掴み、掴んだ瞬間の相対姿勢を手に掛け直して動かす。"
scene = "res://samples/grab_object/sample.tscn"
devices = 15
notes = ""

[sub_resource type="Resource" id="Sample_ui_panel_2d"]
script = ExtResource("2_info")
title = "2D UIパネル"
description = "SubViewportの2D UIを3Dの板に貼り、ポインタをマウス入力として流し込む。"
scene = "res://samples/ui_panel_2d/sample.tscn"
devices = 15
notes = ""

[sub_resource type="Resource" id="Sample_hand_menu"]
script = ExtResource("2_info")
title = "ハンドメニュー"
description = "手のひらを自分へ向けるとメニューが出る。Solver（HandConstraint）相当。"
scene = "res://samples/hand_menu/sample.tscn"
devices = 15
notes = "Hand Trackingが必要"

[sub_resource type="Resource" id="Sample_two_hand_manipulation"]
script = ExtResource("2_info")
title = "両手操作"
description = "両手で掴んで回転・拡縮する。倍率の制約つき。片手なら移動と回転。"
scene = "res://samples/two_hand_manipulation/sample.tscn"
devices = 15
notes = ""

[sub_resource type="Resource" id="Sample_plane_detection"]
script = ExtResource("2_info")
title = "平面検出"
description = "runtimeが検出した平面（床・壁・天井・机）を可視化する。ARPlaneManager相当。"
scene = "res://samples/plane_detection/sample.tscn"
devices = 15
notes = "runtimeが平面検出を公開する場合のみ"

[sub_resource type="Resource" id="Sample_floor_detection"]
script = ExtResource("2_info")
title = "床面検知"
description = "検出された平面から床を選び、取れない端末ではLocal Floorの仮定に落とす。"
scene = "res://samples/floor_detection/sample.tscn"
devices = 15
notes = "Quest 3はSpace Setupが必要"

[sub_resource type="Resource" id="Sample_scene_mesh"]
script = ExtResource("2_info")
title = "部屋メッシュ"
description = "事前スキャン済みの部屋の形を取り出し、当たり判定と可視化を作る。"
scene = "res://samples/scene_mesh/sample.tscn"
devices = 1
notes = "Quest 3のScene APIとSpace Setup"

[sub_resource type="Resource" id="Sample_realtime_planes"]
script = ExtResource("2_info")
title = "リアルタイム平面推定"
description = "深度マップから、見ている先の面をその場で推定する。事前スキャン不要。"
scene = "res://samples/realtime_planes/sample.tscn"
devices = 1
notes = "Quest 3の環境深度"

[sub_resource type="Resource" id="Sample_realtime_mesh"]
script = ExtResource("2_info")
title = "リアルタイム環境メッシュ"
description = "深度マップから毎フレーム更新される環境メッシュを作る。CPU処理なし。"
scene = "res://samples/realtime_mesh/sample.tscn"
devices = 1
notes = "Quest 3の環境深度"

[sub_resource type="Resource" id="Sample_realtime_mesh_collision"]
script = ExtResource("2_info")
title = "環境メッシュの当たり判定"
description = "深度からConcavePolygonShape3Dを作り、実際の床や机でボールを跳ねさせる。"
scene = "res://samples/realtime_mesh_collision/sample.tscn"
devices = 1
notes = "Quest 3の環境深度"

[sub_resource type="Resource" id="Sample_realtime_plane_clusters"]
script = ExtResource("2_info")
title = "リアルタイム複数平面検出"
description = "深度から複数の平面を同時に見つけ、フレーム間で追跡する。ARPlaneManagerの自作版。"
scene = "res://samples/realtime_plane_clusters/sample.tscn"
devices = 1
notes = "Quest 3の環境深度"

[sub_resource type="Resource" id="Sample_occlusion_depth"]
script = ExtResource("2_info")
title = "深度オクルージョン"
description = "実物が仮想物体をリアルタイムに隠す。手や動く物にも効く。"
scene = "res://samples/occlusion_depth/sample.tscn"
devices = 1
notes = "Quest 3の環境深度"

[resource]
script = ExtResource("1_library")
samples = Array[Resource]([SubResource("Sample_passthrough"), SubResource("Sample_hand_tracking"), SubResource("Sample_controller_models"), SubResource("Sample_session_lifecycle"), SubResource("Sample_poke_button"), SubResource("Sample_ray_pointer"), SubResource("Sample_grab_object"), SubResource("Sample_ui_panel_2d"), SubResource("Sample_hand_menu"), SubResource("Sample_two_hand_manipulation"), SubResource("Sample_plane_detection"), SubResource("Sample_floor_detection"), SubResource("Sample_scene_mesh"), SubResource("Sample_realtime_planes"), SubResource("Sample_realtime_mesh"), SubResource("Sample_realtime_mesh_collision"), SubResource("Sample_realtime_plane_clusters"), SubResource("Sample_occlusion_depth")])
